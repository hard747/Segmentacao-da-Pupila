sequenceDiagram
    participant Main as Ponto de Entrada (main.py)
    participant Gerenciador as GerenciadorDispositivos
    participant Detector as DetectorFaixa
    participant Controlador as ControladorSincronizacao
    participant Arduino
    participant Camera
    participant Usuario

    Main->>Gerenciador: Cria uma instância
    activate Gerenciador
    Gerenciador-->>Main: Retorna a instância
    deactivate Gerenciador

    Main->>Detector: Cria uma instância
    activate Detector
    Detector-->>Main: Retorna a instância
    deactivate Detector

    Main->>Controlador: Cria uma instância (passando Gerenciador e Detector)
    activate Controlador
    Controlador-->>Main: Retorna a instância
    deactivate Controlador

    Main->>Controlador: Inicia a execução (executar())
    activate Controlador
    
    loop Loop Principal de Sincronização
        Controlador->>Arduino: Envia comando de sincronização
        activate Arduino
        Arduino->>Arduino: Sincroniza relógio interno
        Arduino-->>Controlador: Envia feedback de sincronização
        deactivate Arduino
        
        Controlador->>Camera: Pede um novo frame
        activate Camera
        Camera-->>Controlador: Retorna o frame da imagem
        deactivate Camera
        
        Controlador->>Detector: Processa o frame (processar_frame_e_detectar_pupila())
        activate Detector
        Detector-->>Controlador: Retorna posição da faixa e tipo de pupila
        deactivate Detector

        Controlador->>Controlador: Calcula desvio de tempo e ajusta sincronização
        
        Controlador->>Usuario: Exibe frames e informações (e.g., FPS)
    end

    Controlador->>Main: Finaliza execução
    deactivate Controlador

    Main->>Gerenciador: Libera recursos (atexit.register)
    Gerenciador->>Arduino: Fecha a porta serial
    Gerenciador->>Camera: Libera a câmera
    Gerenciador-->>Main: Confirma liberação