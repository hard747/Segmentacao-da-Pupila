graph TD
    A[Início] --> B(Inicializar Componentes);
    B --> C{Pular Sincronização Grossa?};
    C -- Sim --> D[Sincronização Fina];
    C -- Não --> E[Sincronização Grossa];
    E --> F[Atualizar período mestre];
    F --> D;

    subgraph Loop Principal
        direction LR
        D --> G(Processar Loop);
        G --> H[Ler frame da câmera];
        H --> I[Detectar faixa e pupila];
        I --> J[Calcular desvio e ajustar estrobo];
        J --> K[Exibir informações na tela];
        K --> L{Condição de saída?};
    end
    
    L -- Não --> G;
    L -- Sim --> M[Finalizar e Limpar Recursos];
    M --> N[Fim];